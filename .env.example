# Скопируйте в .env и заполните. Локально можно оставить только YOOKASSA_*.

DEBUG=True
SECRET_KEY=сгенерируйте-длинную-случайную-строку
ALLOWED_HOSTS=localhost,127.0.0.1
# На хостинге, например:
# ALLOWED_HOSTS=accordroyally.com,www.accordroyally.com
# CSRF_TRUSTED_ORIGINS=https://accordroyally.com,https://www.accordroyally.com

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Логи в файл (ошибки и traceback): logs/django.log, ротация ~2 МБ × 5 файлов.
# На проде включается автоматически при DEBUG=False; локально при отладке:
# DJANGO_FILE_LOG=1
# Уровень: ERROR (по умолчанию), для большего шума — WARNING
# DJANGO_LOG_LEVEL=ERROR
# Каталог logs/ должен быть доступен на запись веб-серверу (chmod на хостинге).
