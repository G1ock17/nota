# Copy to .env and fill in. Never commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# MySQL (used by config.settings.production)
DB_NAME=accounting
DB_USER=accounting
DB_PASSWORD=super-secret
DB_HOST=localhost
DB_PORT=3306

# БД магазина (только если учётка на том же сервере — localhost MySQL)
# SHOP_DB_NAME=...
# SHOP_DB_USER=...
# SHOP_DB_PASSWORD=...
# SHOP_DB_HOST=localhost

# Синхронизация через HTTPS (рекомендуется, если удалённый MySQL недоступен)
SHOP_SYNC_URL=https://accordroyally.com/api/internal/accounting/orders/
SHOP_SYNC_TOKEN=change-me-to-a-long-random-secret

# Email (production password reset)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com

# Optional security toggles
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
